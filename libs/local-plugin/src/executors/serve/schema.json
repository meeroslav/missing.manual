{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "continuous": true,
  "outputCapture": "direct-nodejs",
  "cli": "nx",
  "title": "Serve executor",
  "description": "Serve a Gatsby application.",
  "type": "object",
  "properties": {
    "buildTarget": {
      "type": "string",
      "description": "Target which builds the application"
    },
    "port": {
      "type": "number",
      "description": "Port to listen on.",
      "default": 4200
    },
    "host": {
      "type": "string",
      "description": "Host to listen on.",
      "default": "localhost"
    },
    "https": {
      "type": "boolean",
      "description": "Serve using HTTPS.",
      "default": false
    },
    "open": {
      "type": "boolean",
      "description": "Open the site in your (default) browser for you.",
      "default": false
    },
    "prefixPaths": {
      "type": "boolean",
      "description": "Serve the site with link paths prefixed (set pathPrefix in your config).",
      "default": false
    }
  },
  "required": []
}
