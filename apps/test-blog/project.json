{
  "name": "test-blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/test-blog/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@miro-rs/gatsby-plugin:build",
      "options": {
        "outputPath": "apps/test-blog/public"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@miro-rs/gatsby-plugin:serve",
      "options": {
        "buildTarget": "test-blog:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "test-blog:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
