---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import 'prismjs/themes/prism.css';
import '../../styles/normalize.css';
import '../../styles/style.css';
import '../../styles/main.scss';
import Seo from '../seo/Seo.astro';
import Header from '../header/Header.astro';
import Footer from '../footer/Footer.astro';
import styles from './layout.module.scss';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  hero?: ImageMetadata;
}

const { title, description, canonical, hero } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} canonical={canonical} image={hero} />
  </head>
  <body>
    <div class={styles.layout}>
      <Header />
      {
        hero && (
          <div class={styles.hero}>
            <Image
              src={hero}
              alt="Hero image"
              width={Math.min(hero.width, 1920)}
              widths={[750, 1080, 1366, 1920].filter((w) => w <= hero.width)}
              sizes="100vw"
            />
          </div>
        )
      }
      <slot name="hero" />
      <main class={hero ? styles.main : `${styles.main} ${styles.herolessMain}`}>
        <section class={styles.mainSection}>
          <slot />
        </section>
      </main>
      <Footer />
    </div>
  </body>
</html>
