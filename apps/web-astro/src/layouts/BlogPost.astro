---
import { FaFacebook, FaLinkedin, FaTwitter } from 'react-icons/fa';
import Layout from '../components/layout/Layout.astro';
import H from '../components/heading/Heading.astro';
import Bio from '../components/bio/Bio.astro';
import ExternalLink from '../components/external-link/ExternalLink.astro';
import { type Post, formatDate, getDescription, getReadingTime, getTags, postUrl } from '../utils/posts';
import styles from './blog-post.module.scss';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, cover, coverInfo, canonical } = post.data;
const tags = getTags(post);
const hasTweets = post.body?.includes('twitter-tweet') ?? false;
const url = new URL(postUrl(post), Astro.site).href;
const tweetLink = `https://twitter.com/intent/tweet?text=Check out this post by @meeroslav 👇%0a${url}`;
const fbLink = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
const linkedInLink = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
---

<Layout title={title} description={getDescription(post)} canonical={canonical} hero={cover}>
  <article class={styles.blogPost} itemscope itemtype="http://schema.org/Article">
    <small>{formatDate(date)} ・ {getReadingTime(post)}</small>
    {
      coverInfo && (
        <>
          {' '}
          ・{' '}
          <small>
            Cover by <span set:html={coverInfo} />
          </small>
        </>
      )
    }
    <H>{title}</H>
    <small>
      {
        tags.length > 0 && (
          <span class="tags">
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </span>
        )
      }
    </small>
    <section itemprop="articleBody"><slot /></section>
  </article>

  <hr />
  <p>
    <br />
    Did you like the post? Share it on <ExternalLink to={tweetLink}>Twitter <FaTwitter /></ExternalLink>, <ExternalLink
      to={linkedInLink}>LinkedIn <FaLinkedin /></ExternalLink
    > or <ExternalLink to={fbLink}>Facebook <FaFacebook /></ExternalLink>.
    <br />
    Did you find it helpful? Leaving <ExternalLink to="https://www.paypal.com/paypalme/meeroslav"
      >a small tip <span role="img" aria-label="coffee">☕</span>
    </ExternalLink> helps.
  </p>
  <hr class={styles.bioDivider} />
  <Bio class={styles.blogPost} />
  {hasTweets && <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}
</Layout>
