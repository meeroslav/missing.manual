---
import Layout from '../components/layout/Layout.astro';
import IndexHero from '../components/index-hero/IndexHero.astro';
import MiniPost from '../components/mini-post/MiniPost.astro';
import Talk from '../components/talk/Talk.astro';
import talks from '../../../../libs/data/src/talks.json';
import { formatDate, getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
const today = Date.now();
const upcomingTalks = [...talks]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 10)
  .filter((talk) => new Date(talk.date).getTime() > today);
---

<Layout title="Home">
  <IndexHero slot="hero" text="Miroslav Jonaš" />
  <h2>Latest posts</h2>
  <span></span>
  <span></span>
  {posts.map((post) => <MiniPost post={post} showTags={false} />)}
  {
    upcomingTalks.length > 0 && (
      <>
        <h2>Upcoming talks</h2>
        <span />
        <span />
        {upcomingTalks.map((talk) => (
          <Talk {...talk} date={formatDate(talk.date)} />
        ))}
      </>
    )
  }
</Layout>
