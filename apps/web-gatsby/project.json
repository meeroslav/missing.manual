{
  "name": "web-gatsby",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-gatsby/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@miro-rs/local-plugin:build-gatsby",
      "options": {
        "outputPath": "apps/web-gatsby/public"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@miro-rs/local-plugin:serve-gatsby",
      "options": {
        "buildTarget": "web-gatsby:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "web-gatsby:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
